//@version=6
// =============================================================================
// MULTI-TF PREVIOUS VOLUME PROFILE — v2
// =============================================================================
// Displays previous (completed) volume profiles for up to 3 timeframes
// simultaneously, on any chart TF lower than each profile TF.
//
// v2 changes vs v1:
//   - BUG FIX: works on any chart TF (including 5m, 1m) via
//              ignore_invalid_timeframe=true on intrabar fetches
//   - PRECISION: per-TF volume distribution mode:
//                Proportional (overlap-weighted, ~TV behavior, default)
//                HLC3 concentration (sharper, single-point)
//                Uniform-N (legacy v1 behavior)
//   - PRECISION: per-TF row layout: Number of rows OR Ticks per row
//   - PRECISION: cleaner POC/VAH/VAL expansion algorithm
//   - LAYOUT: per-TF histogram anchor (Left default, or Right)
// =============================================================================

indicator("Multi-TF Previous Volume Profile v2", "MTF Prev VP v2",
     overlay              = true,
     max_boxes_count      = 500,
     max_lines_count      = 500,
     max_labels_count     = 100,
     max_bars_back        = 1000)

// =============================================================================
// USER-DEFINED TYPES
// =============================================================================

type TFConfig
    bool   enabled
    string tfPeriod
    string intrabarTF
    string distMode      // "Proportional" | "HLC3 concentration" | "Uniform-N"
    string rowMode       // "Number of rows" | "Ticks per row"
    int    rowsCount     // used when rowMode = "Number of rows"
    int    ticksPerRow   // used when rowMode = "Ticks per row"
    int    histLookback
    int    levelLookback
    bool   showHist
    bool   showLevels
    bool   extendLevels
    bool   anchorLeft    // true = histogram anchored to period start (extends right)
    color  bullCol
    color  bearCol
    color  pocCol
    color  vahCol
    color  valCol

type HistPeriod
    array<box> bullBoxes
    array<box> bearBoxes
    int        endBar

type LevelPeriod
    line  pocLn
    line  vahLn
    line  valLn
    float pocPrice
    float vahPrice
    float valPrice
    int   startBar
    int   endBar
    bool  pocBroken
    bool  vahBroken
    bool  valBroken
    int   pocInitSide
    int   vahInitSide
    int   valInitSide

type TFState
    array<float>         accH
    array<float>         accL
    array<float>         accO
    array<float>         accC
    array<float>         accV
    int                  periodStartBar
    bool                 firstPeriodSeen
    array<HistPeriod>    hists
    array<LevelPeriod>   levels

// =============================================================================
// INPUTS
// =============================================================================

// ---------- Global ----------
gG = "═══ Global ═══"
valueAreaPct = input.float(70.0, "Value Area %", minval=10, maxval=99, step=1, group=gG)
histWidthPct = input.float(35.0, "Histogram width (% of period width)", minval=5, maxval=90, step=5, group=gG)
extPad       = input.int(0, "Extension padding bars", minval=0, maxval=100, group=gG)
maxRowsCap   = input.int(200, "Max rows per profile (safety cap for Ticks-per-row mode)", minval=20, maxval=500, group=gG,
     tooltip="Hard cap on bin count to prevent runaway profiles on low-tick-size instruments.")

DIST_PROP    = "Proportional (overlap-weighted)"
DIST_HLC3    = "HLC3 concentration (single point)"
DIST_UNIF    = "Uniform-N (v1 legacy)"

ROW_COUNT    = "Number of rows"
ROW_TICKS    = "Ticks per row"

// ---------- Slot 1 (default: Daily) ----------
g1 = "═══ Slot 1 (Daily defaults) ═══"
tf1_en   = input.bool(true,  "Enable Slot 1",                 group=g1)
tf1_tf   = input.timeframe("D", "Profile timeframe",          group=g1)
tf1_itf  = input.timeframe("5", "Intrabar timeframe",         group=g1,
     tooltip="Lower TF used to build profiles. Auto-falls back to chart bars if chart TF is already finer or intrabar TF is invalid.")
tf1_dist = input.string(DIST_PROP, "Volume distribution", options=[DIST_PROP, DIST_HLC3, DIST_UNIF], group=g1)
tf1_rmod = input.string(ROW_COUNT, "Row layout",        options=[ROW_COUNT, ROW_TICKS], group=g1)
tf1_rows = input.int(25, "Number of rows",   minval=5, maxval=200, group=g1)
tf1_tpr  = input.int(5,  "Ticks per row",    minval=1, maxval=1000, group=g1,
     tooltip="Only used when Row layout = Ticks per row. Bin width = ticks × instrument min-tick.")
tf1_hl   = input.int(5,  "Histogram lookback (periods)", minval=0, maxval=50,  group=g1)
tf1_ll   = input.int(50, "Levels lookback (periods)",    minval=0, maxval=300, group=g1)
tf1_sh   = input.bool(true, "Show histogram",  group=g1, inline="s1")
tf1_sl   = input.bool(true, "Show levels",     group=g1, inline="s1")
tf1_ext  = input.bool(false,"Extend levels until broken (else contained in period)", group=g1)
tf1_anch = input.bool(true, "Histogram anchored LEFT (else right)", group=g1)
tf1_bull = input.color(color.new(#26a69a, 30), "Bull", group=g1, inline="c1a")
tf1_bear = input.color(color.new(#ef5350, 30), "Bear", group=g1, inline="c1a")
tf1_poc  = input.color(color.new(color.yellow, 0),  "POC", group=g1, inline="c1b")
tf1_vah  = input.color(color.new(color.blue,  30),  "VAH", group=g1, inline="c1b")
tf1_val  = input.color(color.new(color.blue,  30),  "VAL", group=g1, inline="c1b")

// ---------- Slot 2 (default: Weekly) ----------
g2 = "═══ Slot 2 (Weekly defaults) ═══"
tf2_en   = input.bool(true,  "Enable Slot 2",                 group=g2)
tf2_tf   = input.timeframe("W", "Profile timeframe",          group=g2)
